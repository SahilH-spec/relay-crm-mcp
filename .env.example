# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).
# My Domain URL from Salesforce Setup > My Domain (ends in .my.salesforce.com)
SF_MY_DOMAIN_URL=https://your-name-dev-ed.develop.my.salesforce.com
# Consumer Key and Consumer Secret from your External Client App
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=62.0
